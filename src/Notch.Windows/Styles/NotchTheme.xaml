<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark product palette; contrast themes use the user's Windows colors. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="NotchBackgroundBrush" Color="#050505" />
            <SolidColorBrush x:Key="NotchCardBrush" Color="#141414" />
            <SolidColorBrush x:Key="NotchHairlineBrush" Color="#282828" />
            <SolidColorBrush x:Key="NotchTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NotchMutedBrush" Color="#919191" />
            <SolidColorBrush x:Key="NotchLiveBrush" Color="#68D391" />
            <SolidColorBrush x:Key="NotchWarmBrush" Color="#EFA278" />
            <SolidColorBrush x:Key="NotchSurfaceBrush" Color="#242424" />
            <SolidColorBrush x:Key="NotchDockBrush" Color="#252525" />
            <SolidColorBrush x:Key="NotchArtBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="NotchArtBorderBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="NotchSeparatorBrush" Color="#222222" />
            <SolidColorBrush x:Key="NotchPillBrush" Color="#202020" />
            <SolidColorBrush x:Key="NotchLiveTintBrush" Color="#102218" />
            <SolidColorBrush x:Key="NotchLiveBorderBrush" Color="#365744" />
            <SolidColorBrush x:Key="NotchHeatLowBrush" Color="#292422" />
            <SolidColorBrush x:Key="NotchHeatMediumBrush" Color="#744734" />
            <SolidColorBrush x:Key="NotchHeatHighBrush" Color="#B76F4B" />
            <SolidColorBrush x:Key="NotchChartTrackBrush" Color="#333333" />
            <SolidColorBrush x:Key="NotchColdBrush" Color="#68BCEB" />
            <SolidColorBrush x:Key="NotchPlaceholderBrush" Color="#747474" />
            <SolidColorBrush x:Key="NotchErrorBrush" Color="#FFA6A6" />
            <SolidColorBrush x:Key="NotchPrimaryBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NotchPrimaryForegroundBrush" Color="#050505" />
            <SolidColorBrush x:Key="ButtonBackground" Color="#282828" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#383838" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#454545" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#383838" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#454545" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#525252" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#606060" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#454545" />
            <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#333333" />
            <SolidColorBrush x:Key="TextControlBackground" Color="#191919" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#383838" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#919191" />
            <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#050505" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="NotchBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NotchCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NotchHairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NotchTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NotchMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NotchLiveBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="NotchWarmBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="NotchSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NotchDockBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NotchArtBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NotchArtBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NotchSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NotchPillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NotchLiveTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NotchLiveBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NotchHeatLowBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NotchHeatMediumBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="NotchHeatHighBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="NotchChartTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NotchColdBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="NotchPlaceholderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NotchErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NotchPrimaryBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NotchPrimaryForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ToggleButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TextControlForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="NotchCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NotchCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NotchHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource NotchCardStyle}" />
    <Style x:Key="NotchButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="ButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchButtonStyle}" />
    <Style x:Key="NotchPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource NotchPrimaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource NotchPrimaryForegroundBrush}" />
    </Style>
    <Style x:Key="NotchIconButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchIconButtonStyle}" />
    <Style x:Key="NotchCardButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource NotchCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NotchHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="NotchTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource TextControlBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource NotchTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TextControlBorderBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style x:Key="TextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource NotchTextBoxStyle}" />
    <Style x:Key="NotchTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource NotchTextBrush}" />
    </Style>
    <Style x:Key="TitleStyle" TargetType="TextBlock" BasedOn="{StaticResource NotchTitleStyle}" />
    <Style x:Key="NotchCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource NotchMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="NotchLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource NotchCaptionStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="30" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="NotchPinToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource ToggleButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="FontIcon">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    </Style>
</ResourceDictionary>
