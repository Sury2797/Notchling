<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Native controls and a restrained palette matching the top-attached reference. -->
    <SolidColorBrush x:Key="NotchBackgroundBrush" Color="#050505" />
    <SolidColorBrush x:Key="NotchCardBrush" Color="#141414" />
    <SolidColorBrush x:Key="NotchHairlineBrush" Color="#282828" />
    <SolidColorBrush x:Key="NotchTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NotchMutedBrush" Color="#919191" />
    <SolidColorBrush x:Key="NotchLiveBrush" Color="#68D391" />
    <SolidColorBrush x:Key="NotchWarmBrush" Color="#EFA278" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#282828" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#383838" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#454545" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackFill" Color="#333333" />
    <SolidColorBrush x:Key="TextControlBackground" Color="#191919" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#383838" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#919191" />

    <Style x:Key="NotchCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NotchCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NotchHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource NotchCardStyle}" />
    <Style x:Key="NotchButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#282828" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="ButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchButtonStyle}" />
    <Style x:Key="NotchPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchButtonStyle}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#050505" />
    </Style>
    <Style x:Key="NotchIconButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchIconButtonStyle}" />
    <Style x:Key="NotchCardButtonStyle" TargetType="Button" BasedOn="{StaticResource NotchButtonStyle}">
        <Setter Property="Background" Value="{StaticResource NotchCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NotchHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="NotchTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#191919" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#383838" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style x:Key="TextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource NotchTextBoxStyle}" />
    <Style x:Key="NotchTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="TitleStyle" TargetType="TextBlock" BasedOn="{StaticResource NotchTitleStyle}" />
    <Style x:Key="NotchCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource NotchMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="NotchLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource NotchCaptionStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="30" />
        <Setter Property="FontSize" Value="11" />
    </Style>
</ResourceDictionary>
