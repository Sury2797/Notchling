<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <MinimumSupportedWindowsBuild>19045</MinimumSupportedWindowsBuild>
    <RootNamespace>Notch.Windows</RootNamespace>
    <AssemblyName>Notchling.Windows</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;x86;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- The current SDK PRI pipeline publishes embedded binary XAML for unpackaged apps. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <!-- Use the machine-wide runtime verified by Setup, even if a developer's
         DOTNET_ROOT points at an older or incomplete private installation. -->
    <AppHostDotNetSearch>Global</AppHostDotNetSearch>
    <PublishReadyToRun>false</PublishReadyToRun>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <TieredPGO>true</TieredPGO>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\Notchling.ico</ApplicationIcon>
    <Version>0.4.13</Version>
    <AssemblyVersion>0.4.13.0</AssemblyVersion>
    <FileVersion>0.4.13.0</FileVersion>
    <Product>Notchling</Product>
    <Title>Notchling</Title>
    <AssemblyTitle>Notchling</AssemblyTitle>
    <Company>SuryaK999</Company>
    <Description>Notchling — a native desktop notch for Windows.</Description>
    <Authors>SuryaK999</Authors>
    <Copyright>Copyright © 2026 SuryaK999</Copyright>
  </PropertyGroup>
  <Target Name="ValidateNativeArchitecture" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'x86' and '$(Platform)' != 'ARM64'" Text="Notchling requires Platform=x64, x86 or ARM64." />
    <Error Condition="('$(Platform)' == 'x64' and '$(RuntimeIdentifier)' != 'win-x64') or ('$(Platform)' == 'x86' and '$(RuntimeIdentifier)' != 'win-x86') or ('$(Platform)' == 'ARM64' and '$(RuntimeIdentifier)' != 'win-arm64')" Text="The Windows runtime identifier must match the selected native platform." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <ProjectReference Include="..\Notch.Core\Notch.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE;..\..\THIRD_PARTY_NOTICES.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\product-terms.md;..\..\docs\privacy.md;..\..\docs\support.md" Link="Policies\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\install-update.ps1" Link="Update\install-update.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="product-config.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="product-config.json" Condition="Exists('product-config.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
