<UserControl
    x:Class="Notch.Windows.Views.FeaturedToolsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Notch.Windows.Views"
    FontFamily="Segoe UI" Foreground="{ThemeResource NotchTextBrush}"
    RequestedTheme="Dark">
    <ScrollViewer x:Name="ModuleScroll" AutomationProperties.AutomationId="ModuleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" ZoomMode="Disabled" IsTabStop="False">
    <Grid x:Name="ModuleRoot" Background="Transparent" Padding="20,20,20,18" MinWidth="0" VerticalAlignment="Top">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DensityStates">
                <VisualState x:Name="ComfortableLayout">
                    <VisualState.StateTriggers><local:TextAwareWidthTrigger MinimumWidth="680" AvailableWidth="{Binding ActualWidth, ElementName=ModuleScroll}" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ModuleRoot.Padding" Value="26,24,26,20" />

                        <Setter Target="CalendarSeparatorColumn.Width" Value="1" /><Setter Target="CalendarAgendaColumn.Width" Value="*" />
                        <Setter Target="CalendarSeparator.Visibility" Value="Visible" />
                        <Setter Target="CalendarAgendaGrid.(Grid.Row)" Value="0" /><Setter Target="CalendarAgendaGrid.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="ModuleRoot.Padding" Value="16,18,16,16" /></VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="HomeDensityStates">
                <VisualState x:Name="HomeWide"><VisualState.StateTriggers><local:TextAwareWidthTrigger MinimumWidth="680" AvailableWidth="{Binding ActualWidth, ElementName=ModuleScroll}" /></VisualState.StateTriggers><VisualState.Setters>
                    <Setter Target="HomeSecondColumn.Width" Value="*" /><Setter Target="HomeThirdColumn.Width" Value="*" />
                    <Setter Target="HomeAnalyticsCard.(Grid.Row)" Value="0" /><Setter Target="HomeAnalyticsCard.(Grid.Column)" Value="1" />
                    <Setter Target="HomeSystemCard.(Grid.Row)" Value="0" /><Setter Target="HomeSystemCard.(Grid.Column)" Value="2" />
                    <Setter Target="HomeScreenCard.(Grid.Row)" Value="1" /><Setter Target="HomeScreenCard.(Grid.Column)" Value="0" />
                    <Setter Target="HomeRevenueCard.(Grid.Row)" Value="1" /><Setter Target="HomeRevenueCard.(Grid.Column)" Value="1" />
                    <Setter Target="HomeWeatherCard.(Grid.Row)" Value="1" /><Setter Target="HomeWeatherCard.(Grid.Column)" Value="2" />
                </VisualState.Setters></VisualState>
                <VisualState x:Name="HomeMedium"><VisualState.StateTriggers><local:TextAwareWidthTrigger MinimumWidth="460" AvailableWidth="{Binding ActualWidth, ElementName=ModuleScroll}" /></VisualState.StateTriggers><VisualState.Setters>
                    <Setter Target="HomeSecondColumn.Width" Value="*" />
                    <Setter Target="HomeAnalyticsCard.(Grid.Row)" Value="0" /><Setter Target="HomeAnalyticsCard.(Grid.Column)" Value="1" />
                    <Setter Target="HomeSystemCard.(Grid.Row)" Value="1" /><Setter Target="HomeSystemCard.(Grid.Column)" Value="0" />
                    <Setter Target="HomeScreenCard.(Grid.Row)" Value="1" /><Setter Target="HomeScreenCard.(Grid.Column)" Value="1" />
                    <Setter Target="HomeRevenueCard.(Grid.Row)" Value="2" /><Setter Target="HomeRevenueCard.(Grid.Column)" Value="0" />
                    <Setter Target="HomeWeatherCard.(Grid.Row)" Value="2" /><Setter Target="HomeWeatherCard.(Grid.Column)" Value="1" />
                </VisualState.Setters></VisualState>
                <VisualState x:Name="HomeNarrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="HomeSummaryText.Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="MediaDensityStates">
                <VisualState x:Name="MediaWide"><VisualState.StateTriggers><local:TextAwareWidthTrigger MinimumWidth="680" AvailableWidth="{Binding ActualWidth, ElementName=ModuleScroll}" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="MediaArtColumn.Width" Value="128" /><Setter Target="MediaArtworkBorder.Width" Value="128" /><Setter Target="MediaArtworkBorder.Height" Value="128" /></VisualState.Setters></VisualState>
                <VisualState x:Name="MediaMedium"><VisualState.StateTriggers><local:TextAwareWidthTrigger MinimumWidth="460" AvailableWidth="{Binding ActualWidth, ElementName=ModuleScroll}" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="MediaArtColumn.Width" Value="96" /><Setter Target="MediaArtworkBorder.Width" Value="96" /><Setter Target="MediaArtworkBorder.Height" Value="96" /></VisualState.Setters></VisualState>
                <VisualState x:Name="MediaNarrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="MediaArtColumn.Width" Value="64" /><Setter Target="MediaArtworkBorder.Width" Value="64" /><Setter Target="MediaArtworkBorder.Height" Value="64" /><Setter Target="MediaSourceText.MaxWidth" Value="120" /><Setter Target="OutputDeviceText.MaxWidth" Value="95" /></VisualState.Setters></VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="FocusDensityStates">
                <VisualState x:Name="FocusWide">
                    <VisualState.StateTriggers><local:TextAwareWidthTrigger MinimumWidth="780" AvailableWidth="{Binding ActualWidth, ElementName=ModuleScroll}" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FocusSecondColumn.Width" Value="*" /><Setter Target="FocusThirdColumn.Width" Value="*" /><Setter Target="FocusFourthColumn.Width" Value="*" />
                        <Setter Target="FocusCountdownCard.(Grid.Row)" Value="0" /><Setter Target="FocusCountdownCard.(Grid.Column)" Value="1" />
                        <Setter Target="FocusStopwatchCard.(Grid.Row)" Value="0" /><Setter Target="FocusStopwatchCard.(Grid.Column)" Value="2" />
                        <Setter Target="FocusHydrationCard.(Grid.Row)" Value="0" /><Setter Target="FocusHydrationCard.(Grid.Column)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="FocusTwoColumns">
                    <VisualState.StateTriggers><local:TextAwareWidthTrigger MinimumWidth="460" AvailableWidth="{Binding ActualWidth, ElementName=ModuleScroll}" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FocusSecondColumn.Width" Value="*" />
                        <Setter Target="FocusCountdownCard.(Grid.Row)" Value="0" /><Setter Target="FocusCountdownCard.(Grid.Column)" Value="1" />
                        <Setter Target="FocusStopwatchCard.(Grid.Row)" Value="1" /><Setter Target="FocusStopwatchCard.(Grid.Column)" Value="0" />
                        <Setter Target="FocusHydrationCard.(Grid.Row)" Value="1" /><Setter Target="FocusHydrationCard.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="FocusOneColumn"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="WeatherDensityStates"><VisualState x:Name="WeatherSideBySide"><VisualState.StateTriggers><local:TextAwareWidthTrigger MinimumWidth="560" AvailableWidth="{Binding ActualWidth, ElementName=ModuleScroll}" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="WeatherDetailsSecondColumn.Width" Value="1.35*" /><Setter Target="WeatherHoursCard.(Grid.Row)" Value="0" /><Setter Target="WeatherHoursCard.(Grid.Column)" Value="1" /></VisualState.Setters></VisualState><VisualState x:Name="WeatherStacked"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState></VisualStateGroup>
            <VisualStateGroup x:Name="FreeDensityStates">
                <VisualState x:Name="FreeSideBySide">
                    <VisualState.StateTriggers><local:TextAwareWidthTrigger MinimumWidth="460" AvailableWidth="{Binding ActualWidth, ElementName=ModuleScroll}" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FreeHomeSecondColumn.Width" Value="*" />
                        <Setter Target="FreeHomeFocusCard.(Grid.Row)" Value="0" />
                        <Setter Target="FreeHomeFocusCard.(Grid.Column)" Value="1" />
                        <Setter Target="FreeFocusDetailsColumn.Width" Value="*" />
                        <Setter Target="FreeFocusDetails.(Grid.Row)" Value="0" />
                        <Setter Target="FreeFocusDetails.(Grid.Column)" Value="1" />
                        <Setter Target="FreeFocusDial.HorizontalAlignment" Value="Left" />
                        <Setter Target="FreeFocusDial.Margin" Value="0,0,8,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="FreeStacked">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>



        <!-- Free uses the same native controls as Premium. These persistent trees retain
             keyboard focus and pointer state while live data changes. -->
        <Grid x:Name="FreeHomeView" Visibility="Collapsed" RowSpacing="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="5"><TextBlock x:Name="FreeBrandText" Text="Notchling Free" FontSize="22" FontWeight="SemiBold" /><TextBlock x:Name="FreeHomeDateText" Style="{StaticResource NotchCaptionStyle}" /></StackPanel>
                <Button Grid.Column="1" Style="{StaticResource NotchIconButtonStyle}" Click="HomeSettings_Click" AutomationProperties.Name="Open settings" ToolTipService.ToolTip="Settings" VerticalAlignment="Center"><local:VisualIcon Kind="Settings" Size="16"  /></Button>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="FreeHomeSecondColumn" Width="0" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button Tag="Media" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Media" Padding="16" MinHeight="118">
                    <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><local:VisualIcon Kind="Music" Size="19" Foreground="{ThemeResource NotchLiveBrush}"  /><TextBlock Grid.Column="1" Text="Media" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" /><local:VisualIcon Grid.Column="2" Kind="ChevronRight" Size="11" Foreground="{ThemeResource NotchMutedBrush}"  /></Grid>
                        <StackPanel Grid.Row="1" Spacing="3"><TextBlock x:Name="FreeHomeMediaTitle" FontSize="15" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="FreeHomeMediaDetail" Style="{StaticResource NotchCaptionStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" /></StackPanel>
                    </Grid>
                </Button>
                <Button x:Name="FreeHomeFocusCard" Grid.Row="1" Tag="Focus" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Focus" Padding="16" MinHeight="118">
                    <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><local:VisualIcon Kind="Focus" Size="19" Foreground="{ThemeResource NotchWarmBrush}"  /><TextBlock Grid.Column="1" Text="Focus" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" /><local:VisualIcon Grid.Column="2" Kind="ChevronRight" Size="11" Foreground="{ThemeResource NotchMutedBrush}"  /></Grid>
                        <StackPanel Grid.Row="1" Spacing="3"><TextBlock x:Name="FreeHomeFocusTime" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="FreeHomeFocusStatus" Style="{StaticResource NotchCaptionStyle}" /></StackPanel>
                    </Grid>
                </Button>
            </Grid>
            <Button Grid.Row="2" Tag="Scratchpad" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Scratchpad" Padding="16,12">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <local:VisualIcon Kind="Scratchpad" Size="20" VerticalAlignment="Center" Foreground="{ThemeResource NotchColdBrush}"  /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Scratchpad" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="A thought, saved on this device." Style="{StaticResource NotchCaptionStyle}" /></StackPanel><local:VisualIcon Grid.Column="2" Kind="ChevronRight" Size="11" Foreground="{ThemeResource NotchMutedBrush}" VerticalAlignment="Center"  />
                </Grid>
            </Button>
            <TextBlock Grid.Row="3" Text="Your essentials. No account needed." Style="{StaticResource NotchCaptionStyle}" FontSize="12" />
        </Grid>

        <Grid x:Name="FreeFocusView" Visibility="Collapsed" RowSpacing="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="Focus" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="One clear task. A little room to think." Style="{StaticResource NotchCaptionStyle}" /></StackPanel><Border Grid.Column="1" Background="{ThemeResource NotchPillBrush}" CornerRadius="10" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="POMODORO" Style="{StaticResource NotchLabelStyle}" /></Border></Grid>
            <Border Grid.Row="1" Style="{StaticResource NotchCardStyle}" Padding="20">
                <Grid ColumnSpacing="20" RowSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="FreeFocusDetailsColumn" Width="0" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid x:Name="FreeFocusDial" Width="126" Height="126" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Stroke="{ThemeResource NotchChartTrackBrush}" StrokeThickness="4" /><Path x:Name="FreeFocusArc" Stroke="{ThemeResource NotchLiveBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3"><TextBlock x:Name="FreeFocusTimeText" Text="25:00" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="remaining" Style="{StaticResource NotchCaptionStyle}" HorizontalAlignment="Center" /></StackPanel>
                    </Grid>
                    <StackPanel x:Name="FreeFocusDetails" Grid.Row="1" Spacing="12" VerticalAlignment="Center">
                        <StackPanel Spacing="4"><TextBlock x:Name="FreeFocusStateText" Text="Ready when you are" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="FreeFocusDescriptionText" Style="{StaticResource NotchCaptionStyle}" TextWrapping="Wrap" /></StackPanel>
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Name="FreeFocusToggleButton" Content="Start focus" Style="{StaticResource NotchPrimaryButtonStyle}" HorizontalAlignment="Stretch" Click="FocusToggle_Click" AutomationProperties.Name="Start / pause Pomodoro" /><Button Grid.Column="1" Style="{StaticResource NotchIconButtonStyle}" Click="FocusReset_Click" AutomationProperties.Name="Reset" ToolTipService.ToolTip="Reset Pomodoro"><local:VisualIcon Kind="Refresh" Size="16"  /></Button></Grid>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Grid.Row="2" Text="Pause anytime. Your scratchpad stays within reach." Style="{StaticResource NotchCaptionStyle}" />
        </Grid>

        <Grid x:Name="HomeView" RowSpacing="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4"><TextBlock x:Name="GreetingText" Style="{StaticResource NotchTitleStyle}" /><TextBlock x:Name="HomeDateText" Style="{StaticResource NotchCaptionStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock x:Name="HomeSummaryText" Style="{StaticResource NotchCaptionStyle}" VerticalAlignment="Center" MaxWidth="170" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" /><Button Style="{StaticResource NotchIconButtonStyle}" Click="HomeSettings_Click" AutomationProperties.Name="Open settings"><local:VisualIcon Kind="Settings" Size="14"  /></Button></StackPanel>
            </Grid>
            <Grid x:Name="HomeCardsGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="HomeSecondColumn" Width="0" /><ColumnDefinition x:Name="HomeThirdColumn" Width="0" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button x:Name="HomeServersCard" Grid.Row="0" Grid.Column="0" Tag="Servers" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Open development servers">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="9"><local:VisualIcon Kind="Servers" Size="15"  /><TextBlock Text="Dev servers" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><TextBlock x:Name="HomeServersText" TextTrimming="CharacterEllipsis" Grid.Row="1" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Bottom" /><TextBlock x:Name="HomePortsText" Grid.Row="2" Style="{StaticResource NotchCaptionStyle}" Margin="0,2,0,0" /></Grid>
                </Button>
                <Button x:Name="HomeAnalyticsCard" Grid.Row="1" Grid.Column="0" Tag="Analytics" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Open website analytics">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal" Spacing="9"><local:VisualIcon Kind="Analytics" Size="15"  /><TextBlock Text="Visitors" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><TextBlock x:Name="HomeVisitorsLiveText" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource NotchLiveBrush}" /></Grid><TextBlock x:Name="HomeVisitorsText" TextTrimming="CharacterEllipsis" Grid.Row="1" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Bottom" /><TextBlock x:Name="HomeVisitorsCaption" Grid.Row="2" Style="{StaticResource NotchCaptionStyle}" Margin="0,2,0,0" /></Grid>
                </Button>
                <Button x:Name="HomeSystemCard" Grid.Row="2" Grid.Column="0" Tag="System" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Open system information">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="9"><local:VisualIcon Kind="Analytics" Size="15"  /><TextBlock Text="System" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><StackPanel x:Name="HomeSystemRings" Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" /></Grid>
                </Button>
                <Button x:Name="HomeScreenCard" Grid.Row="3" Grid.Column="0" Tag="ScreenTime" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Open screen time">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="9"><local:VisualIcon Kind="ScreenTime" Size="15"  /><TextBlock Text="Screen time" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><TextBlock x:Name="HomeScreenTimeText" TextTrimming="CharacterEllipsis" Grid.Row="1" FontSize="29" FontWeight="SemiBold" VerticalAlignment="Bottom" /><TextBlock Text="Current desktop session" Grid.Row="2" Style="{StaticResource NotchCaptionStyle}" Margin="0,2,0,0" /></Grid>
                </Button>
                <Button x:Name="HomeRevenueCard" Grid.Row="4" Grid.Column="0" Tag="Revenue" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Open revenue">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="9"><local:VisualIcon Kind="Revenue" Size="15"  /><TextBlock Text="Revenue" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><TextBlock x:Name="HomeRevenueText" TextTrimming="CharacterEllipsis" Grid.Row="1" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Bottom" /><TextBlock x:Name="HomeRevenueCaption" Grid.Row="2" Style="{StaticResource NotchCaptionStyle}" Margin="0,2,0,0" /></Grid>
                </Button>
                <Button x:Name="HomeWeatherCard" Grid.Row="5" Grid.Column="0" Tag="Weather" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Open weather">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="9"><local:VisualIcon Kind="Weather" Size="15"  /><TextBlock Text="Weather" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><TextBlock x:Name="HomeWeatherText" TextTrimming="CharacterEllipsis" Grid.Row="1" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Bottom" /><TextBlock x:Name="HomeWeatherCaption" Grid.Row="2" Style="{StaticResource NotchCaptionStyle}" Margin="0,2,0,0" /></Grid>
                </Button>
            </Grid>
        </Grid>

        <Grid x:Name="MediaView" Visibility="Collapsed" ColumnSpacing="18" RowSpacing="12" VerticalAlignment="Top">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="MediaArtColumn" Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.ColumnSpan="2" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="MediaStateText" Text="MEDIA" Style="{StaticResource NotchLabelStyle}" VerticalAlignment="Center" />
                <Grid Grid.Column="1" ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource NotchPillBrush}" CornerRadius="10" Padding="9,5"><StackPanel Orientation="Horizontal" Spacing="7"><local:MediaSourceIcon x:Name="MediaSourceBadgeIcon" Size="18" /><TextBlock x:Name="MediaSourceText" Style="{StaticResource NotchCaptionStyle}" MaxWidth="180" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" /></StackPanel></Border>
                    <Button x:Name="MediaSourcePickerButton" Grid.Column="1" Style="{StaticResource NotchIconButtonStyle}" Width="28" Height="28" MinHeight="28" CornerRadius="10" Click="MediaSourcePicker_Click" Visibility="Collapsed" AutomationProperties.AutomationId="MediaSourcePicker" AutomationProperties.Name="Choose the website for this browser track" ToolTipService.ToolTip="Choose a provider for this track"><local:VisualIcon Kind="ChevronDown" Size="12" /></Button>
                </Grid>
            </Grid>
            <Border x:Name="MediaArtworkBorder" Grid.Row="1" Width="96" Height="96" CornerRadius="20" Background="{ThemeResource NotchArtBrush}" BorderThickness="1" BorderBrush="{ThemeResource NotchArtBorderBrush}" VerticalAlignment="Top">
                <Grid><local:MediaSourceIcon x:Name="ArtworkPlaceholder" Size="40" Foreground="{ThemeResource NotchPlaceholderBrush}" /><Image x:Name="MediaArtwork" Stretch="UniformToFill" /></Grid>
            </Border>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="MediaTitleText" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" /><local:VisualIcon x:Name="PlayingGlyph" Grid.Column="1" Kind="Equalizer" Size="16" Foreground="{ThemeResource NotchLiveBrush}" VerticalAlignment="Center"  /></Grid>
                <TextBlock x:Name="MediaArtistText" Style="{StaticResource NotchCaptionStyle}" FontSize="13" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="MediaAlbumText" Style="{StaticResource NotchCaptionStyle}" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                <StackPanel x:Name="MediaTimelinePanel" Spacing="5" Margin="0,4,0,0">
                    <Slider x:Name="MediaSeekSlider" Minimum="0" Maximum="1" StepFrequency="0.001" SmallChange="0.01" LargeChange="0.1" MinHeight="36" Margin="0,-6,0,-8" ValueChanged="MediaSeekSlider_ValueChanged" AutomationProperties.Name="Playback position" />
                    <ProgressBar x:Name="MediaReadOnlyProgress" Minimum="0" Maximum="1" Height="3" CornerRadius="2" Foreground="{ThemeResource NotchTextBrush}" Background="{ThemeResource NotchChartTrackBrush}" IsHitTestVisible="False" AutomationProperties.Name="Playback progress" />
                    <Grid><TextBlock x:Name="MediaPositionText" Style="{StaticResource NotchCaptionStyle}" FontSize="12" /><TextBlock x:Name="MediaDurationText" HorizontalAlignment="Right" Style="{StaticResource NotchCaptionStyle}" FontSize="12" /></Grid>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="PreviousButton" Style="{StaticResource NotchIconButtonStyle}" Background="Transparent" Width="44" Height="44" Click="Previous_Click" AutomationProperties.Name="Previous" ToolTipService.ToolTip="Previous track"><local:VisualIcon Kind="Previous" Size="20"  /></Button>
                <Button x:Name="PlayPauseButton" Width="52" Height="52" CornerRadius="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{ThemeResource NotchPrimaryBackgroundBrush}" Foreground="{ThemeResource NotchPrimaryForegroundBrush}" BorderThickness="0" UseSystemFocusVisuals="True" Click="PlayPause_Click" AutomationProperties.Name="Play" ToolTipService.ToolTip="Play"><local:VisualIcon x:Name="PlayPauseIcon" Kind="Play" Size="22"  /></Button>
                <Button x:Name="NextButton" Style="{StaticResource NotchIconButtonStyle}" Background="Transparent" Width="44" Height="44" Click="Next_Click" AutomationProperties.Name="Next" ToolTipService.ToolTip="Next track"><local:VisualIcon Kind="Next" Size="20"  /></Button>
            </StackPanel>
            <Grid x:Name="MediaVolumePanel" Grid.Row="3" Grid.ColumnSpan="2" ColumnSpacing="10" Margin="0,0,0,-4">
