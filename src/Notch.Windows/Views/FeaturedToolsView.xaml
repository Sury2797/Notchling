<UserControl
    x:Class="Notch.Windows.Views.FeaturedToolsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <Grid x:Name="ModuleRoot" Background="Transparent" Padding="26,24,26,20" MinWidth="600">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid x:Name="HomeView" RowSpacing="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4"><TextBlock x:Name="GreetingText" Style="{StaticResource NotchTitleStyle}" /><TextBlock x:Name="HomeDateText" Style="{StaticResource NotchCaptionStyle}" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock x:Name="HomeSummaryText" Style="{StaticResource NotchCaptionStyle}" VerticalAlignment="Center" /><Button Style="{StaticResource NotchIconButtonStyle}" Click="HomeSettings_Click" AutomationProperties.Name="Open settings"><FontIcon Glyph="&#xE713;" FontSize="14" /></Button></StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Button Tag="Servers" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Open development servers">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE968;" FontSize="15" /><TextBlock Text="Dev servers" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><TextBlock x:Name="HomeServersText" Grid.Row="1" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Bottom" /><TextBlock x:Name="HomePortsText" Grid.Row="2" Style="{StaticResource NotchCaptionStyle}" Margin="0,2,0,0" /></Grid>
                </Button>
                <Button Grid.Column="1" Tag="Analytics" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Open website analytics">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE9D9;" FontSize="15" /><TextBlock Text="Visitors" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><TextBlock x:Name="HomeVisitorsLiveText" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource NotchLiveBrush}" /></Grid><TextBlock x:Name="HomeVisitorsText" Grid.Row="1" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Bottom" /><TextBlock x:Name="HomeVisitorsCaption" Grid.Row="2" Style="{StaticResource NotchCaptionStyle}" Margin="0,2,0,0" /></Grid>
                </Button>
                <Button Grid.Column="2" Tag="System" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Open system information">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE9D9;" FontSize="15" /><TextBlock Text="System" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><StackPanel x:Name="HomeSystemRings" Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" /></Grid>
                </Button>
                <Button Grid.Row="1" Tag="ScreenTime" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Open screen time">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE121;" FontSize="15" /><TextBlock Text="Screen time" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><TextBlock x:Name="HomeScreenTimeText" Grid.Row="1" FontSize="29" FontWeight="SemiBold" VerticalAlignment="Bottom" /><TextBlock Text="Current desktop session" Grid.Row="2" Style="{StaticResource NotchCaptionStyle}" Margin="0,2,0,0" /></Grid>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Tag="Revenue" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Open revenue">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE8C7;" FontSize="15" /><TextBlock Text="Revenue" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><TextBlock x:Name="HomeRevenueText" Grid.Row="1" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Bottom" /><TextBlock x:Name="HomeRevenueCaption" Grid.Row="2" Style="{StaticResource NotchCaptionStyle}" Margin="0,2,0,0" /></Grid>
                </Button>
                <Button Grid.Row="1" Grid.Column="2" Tag="Weather" Style="{StaticResource NotchCardButtonStyle}" Click="HomeCard_Click" AutomationProperties.Name="Open weather">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE9BD;" FontSize="15" /><TextBlock Text="Weather" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><TextBlock x:Name="HomeWeatherText" Grid.Row="1" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Bottom" /><TextBlock x:Name="HomeWeatherCaption" Grid.Row="2" Style="{StaticResource NotchCaptionStyle}" Margin="0,2,0,0" /></Grid>
                </Button>
            </Grid>
        </Grid>

        <Grid x:Name="MediaView" Visibility="Collapsed" ColumnSpacing="24" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="168" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="168" Height="168" CornerRadius="24" Background="#1B1B1B" BorderThickness="1" BorderBrush="#2B2B2B">
                <Grid><FontIcon x:Name="ArtworkPlaceholder" Glyph="&#xE8D6;" FontSize="44" Foreground="#747474" /><Image x:Name="MediaArtwork" Stretch="UniformToFill" /></Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="MediaTitleText" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><FontIcon x:Name="PlayingGlyph" Grid.Column="1" Glyph="&#xE90B;" FontSize="18" VerticalAlignment="Center" /></Grid>
                <TextBlock x:Name="MediaArtistText" Style="{StaticResource NotchCaptionStyle}" FontSize="13" />
                <Slider x:Name="MediaSeekSlider" Minimum="0" Maximum="1" StepFrequency="0.001" SmallChange="0.01" LargeChange="0.1" Margin="0,4,0,-5" ValueChanged="MediaSeekSlider_ValueChanged" AutomationProperties.Name="Playback position" />
                <Grid><TextBlock x:Name="MediaPositionText" Style="{StaticResource NotchCaptionStyle}" FontSize="10" /><TextBlock x:Name="MediaDurationText" HorizontalAlignment="Right" Style="{StaticResource NotchCaptionStyle}" FontSize="10" /></Grid>
                <StackPanel Orientation="Horizontal" Spacing="22" HorizontalAlignment="Center" Margin="0,8,0,5">
                    <Button x:Name="PreviousButton" Background="Transparent" BorderThickness="0" Click="Previous_Click" AutomationProperties.Name="Previous track"><FontIcon Glyph="&#xE892;" FontSize="22" /></Button>
                    <Button x:Name="PlayPauseButton" Width="50" Height="50" CornerRadius="25" Background="White" Foreground="Black" BorderThickness="0" Click="PlayPause_Click" AutomationProperties.Name="Play or pause"><FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="23" /></Button>
                    <Button x:Name="NextButton" Background="Transparent" BorderThickness="0" Click="Next_Click" AutomationProperties.Name="Next track"><FontIcon Glyph="&#xE893;" FontSize="22" /></Button>
                </StackPanel>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE992;" FontSize="12" Foreground="#919191" VerticalAlignment="Center" /><Slider x:Name="VolumeSlider" Grid.Column="1" Width="112" Minimum="0" Maximum="1" StepFrequency="0.01" ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.Name="System volume" /><Border Grid.Column="2" CornerRadius="14" Background="#202020" Padding="9,5" VerticalAlignment="Center"><TextBlock x:Name="OutputDeviceText" Style="{StaticResource NotchCaptionStyle}" FontSize="10" MaxWidth="112" /></Border></Grid>
            </StackPanel>
        </Grid>

        <Grid x:Name="RevenueView" Visibility="Collapsed" RowSpacing="18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Revenue" Style="{StaticResource NotchCaptionStyle}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Background="#141414" CornerRadius="18" Padding="3"><Button x:Name="RevenueTodayButton" Tag="1" Content="Today" Style="{StaticResource NotchButtonStyle}" Click="RevenueRange_Click" /><Button x:Name="RevenueWeekButton" Tag="7" Content="7D" Style="{StaticResource NotchButtonStyle}" Click="RevenueRange_Click" /><Button x:Name="RevenueMonthButton" Tag="30" Content="30D" Style="{StaticResource NotchButtonStyle}" Click="RevenueRange_Click" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Background="#141414" CornerRadius="18" Padding="3"><Button x:Name="StripeButton" Tag="Stripe" Content="Stripe" Style="{StaticResource NotchButtonStyle}" Click="RevenueProvider_Click" /><Button x:Name="PolarButton" Tag="Polar" Content="Polar" Style="{StaticResource NotchButtonStyle}" Click="RevenueProvider_Click" /><Button x:Name="DodoButton" Tag="Dodo" Content="Dodo" Style="{StaticResource NotchButtonStyle}" Click="RevenueProvider_Click" /><Button x:Name="AdSenseButton" Tag="AdSense" Content="AdSense" Style="{StaticResource NotchButtonStyle}" Click="RevenueProvider_Click" /></StackPanel></Grid>
            <Grid Grid.Row="1" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock x:Name="RevenueRangeText" Style="{StaticResource NotchCaptionStyle}" /><TextBlock x:Name="RevenueTotalText" Grid.Row="1" FontSize="51" FontWeight="SemiBold" Margin="0,9,0,0" /><TextBlock x:Name="RevenueOrdersText" Grid.Row="2" Style="{StaticResource NotchCaptionStyle}" /><Grid x:Name="RevenueChart" Grid.Row="3" Height="126" VerticalAlignment="Bottom" Margin="0,14,0,0" /><StackPanel x:Name="RevenueConnectPanel" Grid.Row="3" Spacing="10" VerticalAlignment="Center"><TextBlock Text="Connect a payment provider" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="Keep your API key in Windows Credential Manager.&#10;Set up a connection in Settings to load real payments." Style="{StaticResource NotchCaptionStyle}" TextWrapping="Wrap" /><Button Content="Open connections" Style="{StaticResource NotchPrimaryButtonStyle}" Click="HomeSettings_Click" /></StackPanel></Grid>
                <Border Grid.Column="1" Background="#222222" />
                <Grid Grid.Column="2" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock Text="Recent payments" Style="{StaticResource NotchCaptionStyle}" VerticalAlignment="Center" /><Button HorizontalAlignment="Right" Style="{StaticResource NotchIconButtonStyle}" Click="RevenueRefresh_Click" AutomationProperties.Name="Refresh revenue"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PaymentsPanel" /></ScrollViewer></Grid>
            </Grid>
        </Grid>

        <Grid x:Name="AnalyticsView" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="118" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid><StackPanel Spacing="3"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D9;" FontSize="22" /><TextBlock x:Name="AnalyticsSiteText" FontSize="16" FontWeight="SemiBold" /><Border Background="#102218" CornerRadius="10" Padding="7,3"><TextBlock x:Name="AnalyticsLiveText" Text="LIVE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource NotchLiveBrush}" /></Border></StackPanel><TextBlock x:Name="AnalyticsUpdatedText" Style="{StaticResource NotchCaptionStyle}" FontSize="10" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button Content="Connections" Style="{StaticResource NotchButtonStyle}" Click="HomeSettings_Click" /><Button Style="{StaticResource NotchIconButtonStyle}" Click="AnalyticsRefresh_Click" AutomationProperties.Name="Refresh analytics"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button></StackPanel></Grid>
            <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource NotchCardStyle}" BorderBrush="#365744"><StackPanel Spacing="9"><TextBlock Text="● REALTIME" Style="{StaticResource NotchLabelStyle}" Foreground="{StaticResource NotchLiveBrush}" /><TextBlock x:Name="AnalyticsRealtimeText" FontSize="29" FontWeight="SemiBold" /><TextBlock Text="Reported active users" Style="{StaticResource NotchCaptionStyle}" FontSize="10" /></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource NotchCardStyle}"><StackPanel Spacing="9"><TextBlock Text="ACTIVE USERS" Style="{StaticResource NotchLabelStyle}" /><TextBlock x:Name="AnalyticsUsersText" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Current snapshot" Style="{StaticResource NotchCaptionStyle}" FontSize="10" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource NotchCardStyle}"><StackPanel Spacing="9"><TextBlock Text="PAGE VIEWS" Style="{StaticResource NotchLabelStyle}" /><TextBlock x:Name="AnalyticsViewsText" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Current snapshot" Style="{StaticResource NotchCaptionStyle}" FontSize="10" /></StackPanel></Border>
                <Border Grid.Column="3" Style="{StaticResource NotchCardStyle}"><StackPanel Spacing="9"><TextBlock Text="NEW USERS" Style="{StaticResource NotchLabelStyle}" /><TextBlock x:Name="AnalyticsNewUsersText" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Current snapshot" Style="{StaticResource NotchCaptionStyle}" FontSize="10" /></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource NotchCardStyle}"><Grid RowSpacing="9"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="LIVE ACTIVITY" Style="{StaticResource NotchLabelStyle}" /><Grid x:Name="AnalyticsChart" Grid.Row="1" /><TextBlock x:Name="AnalyticsChartCaption" Grid.Row="2" Style="{StaticResource NotchCaptionStyle}" FontSize="10" /></Grid></Border><Border Grid.Column="1" Style="{StaticResource NotchCardStyle}"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="PAGES                                      LIVE USERS" Style="{StaticResource NotchLabelStyle}" /><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AnalyticsPagesPanel" Spacing="6" /></ScrollViewer></Grid></Border></Grid>
        </Grid>

        <Grid x:Name="CodingView" Visibility="Collapsed" RowSpacing="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="114" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid><StackPanel Spacing="5"><TextBlock Text="Coding" Style="{StaticResource NotchCaptionStyle}" /><TextBlock x:Name="CodingProviderText" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="CodingSourceText" Style="{StaticResource NotchCaptionStyle}" FontSize="10" MaxWidth="510" /></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6"><Button Content="Import usage JSONL" Style="{StaticResource NotchButtonStyle}" Click="ImportCoding_Click" /><Button Style="{StaticResource NotchIconButtonStyle}" Click="CodingRefresh_Click" AutomationProperties.Name="Reload coding usage"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button></StackPanel></Grid>
            <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource NotchCardStyle}"><StackPanel Spacing="7"><TextBlock Text="TOKENS RECORDED" Style="{StaticResource NotchLabelStyle}" /><TextBlock x:Name="CodingTokensText" FontSize="27" FontWeight="SemiBold" /><TextBlock x:Name="CodingTokenDetailText" Style="{StaticResource NotchCaptionStyle}" FontSize="10" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource NotchCardStyle}"><StackPanel Spacing="7"><TextBlock Text="PLAN LIMITS" Style="{StaticResource NotchLabelStyle}" /><TextBlock Text="Provided by your coding app" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Local token logs do not include account quotas." Style="{StaticResource NotchCaptionStyle}" FontSize="10" TextWrapping="Wrap" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource NotchCardStyle}"><StackPanel Spacing="9"><TextBlock Text="LOCAL ACTIVITY" Style="{StaticResource NotchLabelStyle}" /><TextBlock x:Name="CodingSessionsText" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="CodingDaysText" Style="{StaticResource NotchCaptionStyle}" FontSize="10" /></StackPanel></Border></Grid>
            <Border Grid.Row="2" Style="{StaticResource NotchCardStyle}"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><TextBlock Text="ACTIVITY HEATMAP" Style="{StaticResource NotchLabelStyle}" /><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4"><TextBlock Text="Less" Style="{StaticResource NotchCaptionStyle}" FontSize="9" /><Rectangle Width="9" Height="9" Fill="#292422" RadiusX="2" RadiusY="2" /><Rectangle Width="9" Height="9" Fill="#744734" RadiusX="2" RadiusY="2" /><Rectangle Width="9" Height="9" Fill="#B76F4B" RadiusX="2" RadiusY="2" /><Rectangle Width="9" Height="9" Fill="#EFA278" RadiusX="2" RadiusY="2" /><TextBlock Text="More" Style="{StaticResource NotchCaptionStyle}" FontSize="9" /></StackPanel></Grid><Grid x:Name="CodingHeatmap" Grid.Row="1" /><TextBlock x:Name="CodingHeatmapCaption" Grid.Row="2" Style="{StaticResource NotchCaptionStyle}" FontSize="10" /></Grid></Border>
        </Grid>

        <Grid x:Name="CalendarView" Visibility="Collapsed" ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid RowSpacing="15"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock x:Name="CalendarMonthText" FontSize="26" FontWeight="SemiBold" /><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="5"><Button Style="{StaticResource NotchIconButtonStyle}" Click="PreviousMonth_Click" AutomationProperties.Name="Previous month"><FontIcon Glyph="&#xE76B;" FontSize="12" /></Button><Button Style="{StaticResource NotchIconButtonStyle}" Click="NextMonth_Click" AutomationProperties.Name="Next month"><FontIcon Glyph="&#xE76C;" FontSize="12" /></Button></StackPanel></Grid><Grid x:Name="CalendarDaysGrid" Grid.Row="1" /></Grid>
            <Border Grid.Column="1" Background="#222222" />
            <Grid Grid.Column="2" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><StackPanel Spacing="2"><TextBlock x:Name="CalendarDayText" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="CalendarDateText" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><TextBlock x:Name="ReminderCountText" HorizontalAlignment="Right" Style="{StaticResource NotchCaptionStyle}" Margin="0,5,0,0" /></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12"><Border x:Name="CalendarConnectPanel" Style="{StaticResource NotchCardStyle}" Padding="14"><StackPanel Spacing="8"><TextBlock Text="See your day here" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Import a calendar .ics file to keep events nearby.&#10;Meeting links open in your browser." Style="{StaticResource NotchCaptionStyle}" TextWrapping="Wrap" /><Button Content="Import calendar" Style="{StaticResource NotchPrimaryButtonStyle}" HorizontalAlignment="Stretch" Click="ImportCalendar_Click" /></StackPanel></Border><StackPanel x:Name="CalendarEventsPanel" Spacing="8" /><TextBlock Text="REMINDERS" Style="{StaticResource NotchLabelStyle}" /><StackPanel x:Name="RemindersPanel" Spacing="8" /></StackPanel></ScrollViewer><Button Grid.Row="2" Content="+ Add reminder" Style="{StaticResource NotchButtonStyle}" HorizontalAlignment="Stretch" Click="AddReminder_Click" /></Grid>
        </Grid>

        <Grid x:Name="WeatherView" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="142" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="Weather" Style="{StaticResource NotchCaptionStyle}" /><TextBlock x:Name="WeatherCityText" Style="{StaticResource NotchCaptionStyle}" FontSize="11" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="7"><Button Content="⌕  Change city" Style="{StaticResource NotchButtonStyle}" Click="ChangeCity_Click" /><Button Style="{StaticResource NotchIconButtonStyle}" Click="WeatherRefresh_Click" AutomationProperties.Name="Refresh weather"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button></StackPanel></Grid>
            <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.35*" /></Grid.ColumnDefinitions><Border Style="{StaticResource NotchCardStyle}"><StackPanel VerticalAlignment="Center" Spacing="10"><StackPanel Orientation="Horizontal" Spacing="16"><FontIcon x:Name="WeatherCurrentIcon" Glyph="&#xE9BD;" FontSize="40" /><StackPanel Spacing="2"><TextBlock x:Name="WeatherTemperatureText" FontSize="32" FontWeight="SemiBold" /><TextBlock x:Name="WeatherConditionText" Style="{StaticResource NotchCaptionStyle}" FontSize="11" /></StackPanel></StackPanel><TextBlock x:Name="WeatherDetailText" Style="{StaticResource NotchCaptionStyle}" FontSize="11" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource NotchCardStyle}"><Grid x:Name="WeatherHoursGrid" VerticalAlignment="Center" /></Border></Grid>
            <Border Grid.Row="2" Style="{StaticResource NotchCardStyle}"><Grid x:Name="WeatherDaysGrid" VerticalAlignment="Center" /></Border>
            <HyperlinkButton Content="Forecast data: Open-Meteo" NavigateUri="https://open-meteo.com/" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="10" Foreground="#919191" Padding="16,4" />
        </Grid>

        <Grid x:Name="FocusView" Visibility="Collapsed" RowSpacing="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><TextBlock Text="Focus" Style="{StaticResource NotchCaptionStyle}" /><TextBlock x:Name="FocusStatusText" HorizontalAlignment="Right" Style="{StaticResource NotchCaptionStyle}" /></Grid>
            <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource NotchCardStyle}" Padding="13,15"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="POMODORO" Style="{StaticResource NotchLabelStyle}" /><StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><Grid Width="81" Height="81"><Ellipse Stroke="#333333" StrokeThickness="4" /><Path x:Name="FocusArc" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><TextBlock x:Name="FocusTimeText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" FontFamily="Cascadia Mono" /></Grid><TextBlock Text="Focus" HorizontalAlignment="Center" Style="{StaticResource NotchCaptionStyle}" /></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center"><Button x:Name="FocusToggleButton" Content="Start" Style="{StaticResource NotchPrimaryButtonStyle}" Click="FocusToggle_Click" /><Button Content="Reset" Style="{StaticResource NotchButtonStyle}" Click="FocusReset_Click" /></StackPanel></Grid></Border>
                <Border Grid.Column="1" Style="{StaticResource NotchCardStyle}" Padding="13,15"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="COUNTDOWN" Style="{StaticResource NotchLabelStyle}" /><StackPanel Grid.Row="1" Spacing="6" VerticalAlignment="Center"><Button Content="Coffee        5m  ▸" Tag="5" Style="{StaticResource NotchButtonStyle}" HorizontalAlignment="Stretch" Click="Countdown_Click" /><Button Content="Break        10m  ▸" Tag="10" Style="{StaticResource NotchButtonStyle}" HorizontalAlignment="Stretch" Click="Countdown_Click" /><Button Content="Sprint       25m  ▸" Tag="25" Style="{StaticResource NotchButtonStyle}" HorizontalAlignment="Stretch" Click="Countdown_Click" /></StackPanel><TextBlock x:Name="CountdownTimeText" Grid.Row="2" HorizontalAlignment="Center" Style="{StaticResource NotchCaptionStyle}" /></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource NotchCardStyle}" Padding="13,15"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="STOPWATCH" Style="{StaticResource NotchLabelStyle}" /><StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"><TextBlock x:Name="StopwatchTimeText" FontSize="21" FontWeight="SemiBold" FontFamily="Cascadia Mono" /><Button x:Name="StopwatchLapButton" Content="Record lap" Style="{StaticResource NotchButtonStyle}" Click="StopwatchLap_Click" /></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7"><Button x:Name="StopwatchToggleButton" Content="Start" Style="{StaticResource NotchPrimaryButtonStyle}" Click="StopwatchToggle_Click" /><Button Content="Reset" Style="{StaticResource NotchButtonStyle}" Click="StopwatchReset_Click" /></StackPanel></Grid></Border>
                <Border Grid.Column="3" Style="{StaticResource NotchCardStyle}" Padding="13,15"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="HYDRATION" Style="{StaticResource NotchLabelStyle}" /><StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"><FontIcon Glyph="&#xE9BD;" Foreground="#68BCEB" FontSize="27" /><TextBlock x:Name="HydrationTimeText" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="HydrationIntervalText" Style="{StaticResource NotchCaptionStyle}" FontSize="10" /></StackPanel><Button Grid.Row="2" Content="Drank water" Style="{StaticResource NotchButtonStyle}" HorizontalAlignment="Center" Click="DrankWater_Click" /></Grid></Border>
            </Grid>
        </Grid>
        <TextBlock x:Name="LocalErrorText" Grid.Row="1" Visibility="Collapsed" Foreground="#FFA6A6" FontSize="11" TextWrapping="Wrap" MaxLines="2" Margin="0,10,0,0" />
    </Grid>
    </ScrollViewer>
</UserControl>
