                <Border x:Name="FocusCountdownCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource NotchCardStyle}" Padding="13,15"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="COUNTDOWN" Style="{StaticResource NotchLabelStyle}" /><StackPanel Grid.Row="1" Spacing="6" VerticalAlignment="Center"><Button Tag="5" Style="{StaticResource NotchButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="Countdown_Click" AutomationProperties.Name="Start 5 minute coffee countdown"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Coffee" /><TextBlock Grid.Column="1" Text="5m" Foreground="{ThemeResource NotchMutedBrush}" /></Grid></Button><Button Tag="10" Style="{StaticResource NotchButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="Countdown_Click" AutomationProperties.Name="Start 10 minute break countdown"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Break" /><TextBlock Grid.Column="1" Text="10m" Foreground="{ThemeResource NotchMutedBrush}" /></Grid></Button><Button Tag="25" Style="{StaticResource NotchButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="Countdown_Click" AutomationProperties.Name="Start 25 minute sprint countdown"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Sprint" /><TextBlock Grid.Column="1" Text="25m" Foreground="{ThemeResource NotchMutedBrush}" /></Grid></Button></StackPanel><TextBlock x:Name="CountdownTimeText" AutomationProperties.AutomationId="CountdownTimeText" Grid.Row="2" HorizontalAlignment="Center" Style=