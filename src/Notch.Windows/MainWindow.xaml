<Window x:Class="Notch.Windows.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Notch — Desktop companion">
  <Grid x:Name="RootGrid" Background="#050505" KeyDown="OnKeyDown"
    PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="BodyRow" Height="40" />
      <RowDefinition x:Name="GapRow" Height="0" />
      <RowDefinition x:Name="ToolbarRow" Height="0" />
      <RowDefinition x:Name="TailRow" Height="0" />
    </Grid.RowDefinitions>
    <Border x:Name="PanelSurface" CornerRadius="0,0,26,26" Background="#050505">
      <Grid>
        <Button x:Name="CompactButton" Background="Transparent" BorderThickness="0" Padding="15,0"
          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnOpenClick">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
            <Border Background="#282828" CornerRadius="6" Width="22" Height="22"><FontIcon Glyph="&#xE80F;" FontSize="12" /></Border>
            <TextBlock x:Name="CompactTitle" Grid.Column="1" Text="Notch" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <FontIcon x:Name="CompactGlyph" Grid.Column="2" Glyph="&#xE8D6;" FontSize="14" />
          </Grid>
        </Button>
        <Grid x:Name="ExpandedContent" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="22" /></Grid.RowDefinitions>
          <ContentControl x:Name="ToolContent" IsEnabled="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
          <TextBlock x:Name="StatusText" Grid.Row="1" FontSize="10" Foreground="#858585" Margin="24,0,24,7" TextTrimming="CharacterEllipsis" />
          <InfoBar x:Name="ErrorBar" VerticalAlignment="Bottom" Margin="16,0,16,24" Severity="Error" IsOpen="False" IsClosable="True" CloseButtonClick="OnErrorClosed" />
        </Grid>
        <Grid x:Name="ActivityContent" Visibility="Collapsed" Padding="20,18" ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
          <Border Background="#242424" CornerRadius="10" Height="36" VerticalAlignment="Top"><FontIcon x:Name="ActivityGlyph" Glyph="&#xE8EA;" FontSize="19" /></Border>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock x:Name="ActivitySource" Foreground="#999999" FontSize="10" CharacterSpacing="60" />
            <TextBlock x:Name="ActivityTitle" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ActivityDetail" FontSize="11" Foreground="#999999" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Content="Dismiss" Style="{StaticResource NotchButtonStyle}" Click="OnDismissActivity" />
              <Button Content="Open" Style="{StaticResource NotchPrimaryButtonStyle}" Click="OnOpenActivity" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="2" Content="×" Style="{StaticResource NotchIconButtonStyle}" Click="OnDismissActivity" AutomationProperties.Name="Dismiss activity" />
        </Grid>
      </Grid>
    </Border>
    <Grid x:Name="ToolbarGrid" Grid.Row="2" Height="48" HorizontalAlignment="Center" Visibility="Collapsed" ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="608" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
      <Border CornerRadius="24" Background="#252525" Padding="5,4"><Grid x:Name="NavigationButtons" /></Border>
      <Border Grid.Column="1" CornerRadius="24" Background="#252525" Padding="5,4">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
          <Button Style="{StaticResource NotchIconButtonStyle}" Background="Transparent" Click="OnSettingsClick" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings"><FontIcon Glyph="&#xE713;" FontSize="16" /></Button>
          <Button x:Name="PinButton" IsEnabled="False" Style="{StaticResource NotchIconButtonStyle}" Background="Transparent" Click="OnPinClick" ToolTipService.ToolTip="Keep expanded" AutomationProperties.Name="Keep notch expanded"><FontIcon Glyph="&#xE718;" FontSize="16" /></Button>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
