<Window x:Class="Notch.Windows.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Notchling — Desktop notch">
  <Grid x:Name="RootGrid" Background="{ThemeResource NotchBackgroundBrush}" KeyDown="OnKeyDown"
    PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="BodyRow" Height="40" />
      <RowDefinition x:Name="GapRow" Height="0" />
      <RowDefinition x:Name="ToolbarRow" Height="0" />
      <RowDefinition x:Name="TailRow" Height="0" />
    </Grid.RowDefinitions>
    <Border x:Name="PanelSurface" CornerRadius="0,0,26,26" Background="{ThemeResource NotchBackgroundBrush}">
      <Grid>
        <Button x:Name="CompactButton" Background="Transparent" BorderThickness="0" Padding="15,0"
          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnOpenClick" UseSystemFocusVisuals="True" AutomationProperties.Name="Open Notchling">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/Notchling.png" Width="22" Height="22" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="CompactTitle" Grid.Column="1" Text="Notchling" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <FontIcon x:Name="CompactGlyph" Grid.Column="2" Glyph="&#xE8D6;" FontSize="14" />
          </Grid>
        </Button>
        <Grid x:Name="ExpandedContent" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ContentControl x:Name="ToolContent" IsEnabled="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
          <TextBlock x:Name="StatusText" Grid.Row="1" FontSize="12" Foreground="{ThemeResource NotchMutedBrush}" Margin="24,0,24,7" TextTrimming="CharacterEllipsis" />
          <InfoBar x:Name="ErrorBar" Grid.Row="2" VerticalAlignment="Bottom" Margin="16,0,16,8" Severity="Error" IsOpen="False" IsClosable="True" CloseButtonClick="OnErrorClosed" />
        </Grid>
        <ScrollViewer x:Name="ActivityContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="20,18" ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
          <Border Background="{ThemeResource NotchSurfaceBrush}" CornerRadius="10" Height="36" VerticalAlignment="Top"><FontIcon x:Name="ActivityGlyph" Glyph="&#xE8EA;" FontSize="19" /></Border>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock x:Name="ActivitySource" Foreground="{ThemeResource NotchMutedBrush}" FontSize="12" CharacterSpacing="60" />
            <TextBlock x:Name="ActivityTitle" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ActivityDetail" FontSize="12" Foreground="{ThemeResource NotchMutedBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Content="Dismiss" Style="{StaticResource NotchButtonStyle}" Click="OnDismissActivity" />
              <Button x:Name="ActivityOpenButton" Content="Open" Style="{StaticResource NotchPrimaryButtonStyle}" Click="OnOpenActivity" AutomationProperties.Name="Open activity destination" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="2" Content="×" Style="{StaticResource NotchIconButtonStyle}" Click="OnDismissActivity" AutomationProperties.Name="Dismiss activity" />
        </Grid>
        </ScrollViewer>
      </Grid>
    </Border>
    <Grid x:Name="ToolbarGrid" Grid.Row="2" Height="48" HorizontalAlignment="Center" Visibility="Collapsed" ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="608" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
      <Border CornerRadius="24" Background="{ThemeResource NotchDockBrush}" Padding="5,4"><Grid x:Name="NavigationButtons" /></Border>
      <Border Grid.Column="1" CornerRadius="24" Background="{ThemeResource NotchDockBrush}" Padding="5,4">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
          <Button Style="{StaticResource NotchIconButtonStyle}" Background="Transparent" Click="OnSettingsClick" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings"><FontIcon Glyph="&#xE713;" FontSize="16" /></Button>
          <ToggleButton x:Name="PinButton" IsEnabled="False" IsThreeState="False" Style="{StaticResource NotchPinToggleStyle}" Click="OnPinClick" ToolTipService.ToolTip="Keep expanded" AutomationProperties.Name="Keep Notchling expanded"><FontIcon Glyph="&#xE718;" FontSize="16" /></ToggleButton>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
