<Window x:Class="Notch.Windows.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="using:Notch.Windows.Views"
  Title="Notchling — Desktop notch">
  <Grid x:Name="RootGrid" Background="{ThemeResource NotchBackgroundBrush}" KeyDown="OnKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="BodyRow" Height="40" />
      <RowDefinition x:Name="GapRow" Height="0" />
      <RowDefinition x:Name="ToolbarRow" Height="0" />
      <RowDefinition x:Name="TailRow" Height="0" />
    </Grid.RowDefinitions>
    <Border x:Name="PanelSurface" HorizontalAlignment="Center" CornerRadius="0,0,26,26" Background="{ThemeResource NotchBackgroundBrush}">
      <Grid>
        <Button x:Name="CompactButton" Style="{StaticResource NotchCompactButtonStyle}" Background="Transparent" BorderThickness="0" Padding="15,0"
          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnOpenClick" UseSystemFocusVisuals="True" AutomationProperties.Name="Open Notchling">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
            <Grid>
              <Image x:Name="CompactArtwork" Source="ms-appx:///Assets/Notchling.png" Width="22" Height="22" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
              <views:MediaSourceIcon x:Name="CompactSourceIcon" Size="22" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="CompactTitle" Grid.Column="1" Text="Notchling" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Grid Grid.Column="2">
              <views:VisualIcon x:Name="CompactGlyph" Kind="ChevronDown" Size="14" />
              <Border x:Name="UpdateBadge" Width="6" Height="6" Background="{ThemeResource NotchColdBrush}" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
          </Grid>
        </Button>
        <Grid x:Name="ExpandedContent" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ContentControl x:Name="ToolContent" IsEnabled="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
          <Grid x:Name="DemoStrip" Grid.Row="1" Visibility="Collapsed" Margin="20,0,20,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Preview · sample data" Foreground="{ThemeResource NotchWarmBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="Exit preview" Style="{StaticResource NotchButtonStyle}" Click="OnExitDemoClick" AutomationProperties.Name="Exit sample data preview" />
          </Grid>
          <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12" Foreground="{ThemeResource NotchMutedBrush}" Margin="24,0,24,7" TextTrimming="CharacterEllipsis" />
          <InfoBar x:Name="ErrorBar" AutomationProperties.Name="Notchling error" Grid.Row="3" VerticalAlignment="Bottom" Margin="16,0,16,8" Severity="Error" IsOpen="False" IsClosable="True" CloseButtonClick="OnErrorClosed" />
        </Grid>
        <ScrollViewer x:Name="ActivityContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="20,18" ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
          <Border Background="{ThemeResource NotchSurfaceBrush}" CornerRadius="10" Height="36" VerticalAlignment="Top"><views:VisualIcon x:Name="ActivityGlyph" Kind="Notification" Size="20" /></Border>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock x:Name="ActivitySource" Foreground="{ThemeResource NotchMutedBrush}" FontSize="12" CharacterSpacing="60" />
            <TextBlock x:Name="ActivityTitle" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ActivityDetail" FontSize="12" Foreground="{ThemeResource NotchMutedBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Content="Dismiss" Style="{StaticResource NotchButtonStyle}" Click="OnDismissActivity" />
              <Button x:Name="ActivityOpenButton" Content="Open" Style="{StaticResource NotchPrimaryButtonStyle}" Click="OnOpenActivity" AutomationProperties.Name="Open activity destination" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource NotchIconButtonStyle}" Click="OnDismissActivity" AutomationProperties.Name="Dismiss activity"><views:VisualIcon Kind="Close" Size="16" /></Button>
        </Grid>
        </ScrollViewer>
      </Grid>
    </Border>
    <Grid x:Name="ToolbarGrid" Grid.Row="2" Height="48" HorizontalAlignment="Center" Visibility="Collapsed" ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="608" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
      <Border CornerRadius="24" Background="{ThemeResource NotchDockBrush}" Padding="5,4"><Grid x:Name="NavigationButtons" /></Border>
      <Border Grid.Column="1" CornerRadius="24" Background="{ThemeResource NotchDockBrush}" Padding="5,4">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
          <Button Style="{StaticResource NotchIconButtonStyle}" Background="Transparent" Click="OnSettingsClick" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings"><views:VisualIcon Kind="Settings" Size="19" /></Button>
          <ToggleButton x:Name="PinButton" IsEnabled="False" IsThreeState="False" Style="{StaticResource NotchPinToggleStyle}" Checked="OnPinToggled" Unchecked="OnPinToggled" ToolTipService.ToolTip="Keep expanded" AutomationProperties.Name="Keep Notchling expanded"><views:VisualIcon Kind="Pin" Size="18" /></ToggleButton>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
